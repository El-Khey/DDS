<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Types simples -->
    <xs:simpleType name="usageTelephone">
        <xs:restriction base="xs:string">
            <xs:enumeration value="personnel"/>
            <xs:enumeration value="professionnel"/>
            <xs:enumeration value="mobile"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="statutSejour">
        <xs:restriction base="xs:string">
            <xs:enumeration value="en_attente"/>
            <xs:enumeration value="confirme"/>
            <xs:enumeration value="annule"/>
            <xs:enumeration value="termine"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="indiceCanicule">
        <xs:restriction base="xs:string">
            <xs:enumeration value="faible"/>
            <xs:enumeration value="modere"/>
            <xs:enumeration value="eleve"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ouiNon">
        <xs:restriction base="xs:string">
            <xs:enumeration value="oui"/>
            <xs:enumeration value="non"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="montant">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Types complexes réutilisés -->
    <xs:complexType name="adresseType">
        <xs:sequence>
            <xs:element name="rue" type="xs:string"/>
            <xs:element name="code_postal" type="xs:string"/>
            <xs:element name="ville" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="telephoneType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="usage" type="usageTelephone"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Émetteur et client partagent la même structure -->
    <xs:complexType name="personneType">
        <xs:sequence>
            <xs:element name="nom" type="xs:string"/>
            <xs:element name="prenom" type="xs:string"/>
            <xs:element name="adresse" type="adresseType"/>
            <xs:element name="email" type="xs:string"/>
            <xs:element name="tel" type="telephoneType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="environnementType">
        <xs:sequence>
            <xs:element name="temperature_moyenne_ete" type="xs:decimal" minOccurs="0"/>
            <xs:element name="indice_canicule" type="indiceCanicule" minOccurs="0"/>
            <xs:element name="altitude" type="xs:integer" minOccurs="0"/>
            <xs:element name="services_disponibles" type="xs:string" minOccurs="0"/>
            <xs:element name="informations_meteo" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="activiteType">
        <xs:sequence>
            <xs:element name="nom" type="xs:string"/>
            <xs:element name="type_activite" type="xs:string"/>
            <xs:element name="distance_km" type="montant" minOccurs="0"/>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="logementType">
        <xs:sequence>
            <xs:element name="type_bien" type="xs:string"/>
            <xs:element name="description" type="xs:string"/>
            <xs:element name="adresse" type="adresseType"/>
            <xs:element name="loyer_mensuel" type="montant"/>
            <xs:element name="charges" type="montant"/>
            <xs:element name="depot_garantie" type="montant"/>
            <xs:element name="frais_agence" type="montant"/>
            <xs:element name="environnement_logement" type="environnementType" minOccurs="0"/>
            <xs:element name="activites_proximite" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="activite" type="activiteType" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <!-- idLogement est une clé : les lignes de facture y font référence -->
        <xs:attribute name="idLogement" type="xs:ID" use="required"/>
        <xs:attribute name="meuble" type="ouiNon"/>
    </xs:complexType>

    <!-- Facture -->
    <xs:element name="facture">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="emetteur" type="personneType"/>
                <xs:element name="client" type="personneType"/>

                <xs:element name="sejour">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="date_debut" type="xs:date"/>
                            <xs:element name="date_fin" type="xs:date"/>
                            <xs:element name="statut" type="statutSejour"/>
                            <xs:element name="montant_total" type="montant"/>
                        </xs:sequence>
                        <xs:attribute name="idSejour" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>

                <xs:element name="offre_logement">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="logement" type="logementType" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="details_paiement">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="ligne_facture" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="libelle" type="xs:string"/>
                                        <xs:element name="montant" type="montant"/>
                                    </xs:sequence>
                                    <xs:attribute name="refLogement" type="xs:IDREF" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="total">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="montant">
                                <xs:attribute name="devise" type="xs:string"/>
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="numero" type="xs:string" use="required"/>
            <xs:attribute name="date" type="xs:date" use="required"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
