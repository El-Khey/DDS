{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "id": "facture.schema.json",
    "title": "Facture",
    "description": "Facture reçue par le réfugié climatique pour un séjour dans un logement.",
    "type": "object",
    "required": ["facture"],
    "properties": {
        "facture": {
            "type": "object",
            "required": [
                "@numero",
                "@date",
                "emetteur",
                "client",
                "sejour",
                "offre_logement",
                "details_paiement",
                "total"
            ],
            "properties": {
                "@numero": {"type": "string"},
                "@date": {"$ref": "#/definitions/date"},
                "emetteur": {"$ref": "logement.schema.json#/definitions/personne"},
                "client": {"$ref": "logement.schema.json#/definitions/personne"},
                "sejour": {
                    "type": "object",
                    "required": ["@idSejour", "date_debut", "date_fin", "statut", "montant_total"],
                    "properties": {
                        "@idSejour": {"type": "string"},
                        "date_debut": {"$ref": "#/definitions/date"},
                        "date_fin": {"$ref": "#/definitions/date"},
                        "statut": {"enum": ["en_attente", "confirme", "annule", "termine"]},
                        "montant_total": {"type": "number", "minimum": 0}
                    }
                },
                "offre_logement": {
                    "type": "object",
                    "required": ["logement"],
                    "properties": {
                        "logement": {
                            "type": "array",
                            "minItems": 1,
                            "items": {"$ref": "logement.schema.json#/definitions/logement"}
                        }
                    }
                },
                "details_paiement": {
                    "type": "object",
                    "required": ["ligne_facture"],
                    "properties": {
                        "ligne_facture": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "object",
                                "required": ["@refLogement", "libelle", "montant"],
                                "properties": {
                                    "@refLogement": {"type": "string"},
                                    "libelle": {"type": "string"},
                                    "montant": {"type": "number", "minimum": 0}
                                }
                            }
                        }
                    }
                },
                "total": {
                    "type": "object",
                    "required": ["#text"],
                    "properties": {
                        "@devise": {"type": "string"},
                        "#text": {"type": "number", "minimum": 0}
                    }
                }
            }
        }
    },
    "definitions": {
        "date": {
            "description": "Date au format AAAA-MM-JJ.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
    }
}
